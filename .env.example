# Copy this file to .env and adjust the values for your environment.
# Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=jobqueue
POSTGRES_USER=jobqueue
POSTGRES_PASSWORD=jobqueue_dev_password

# JDBC URL used by the Spring Boot API (keep the database name in sync with POSTGRES_DB)
DATABASE_URL=jdbc:postgresql://postgres:5432/jobqueue

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Host ports mapped to the containers (change REDIS_HOST_PORT if 6379 is already in use)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Host port mapped to the API container
APP_PORT=8080

# API background loops (ISO-8601 durations)
OUTBOX_INTERVAL=PT2S
DISPATCH_INTERVAL=PT2S

# Worker behaviour (ISO-8601 durations)
WORKER_LEASE=PT5M
RETRY_BASE_DELAY=PT1S
RETRY_MAX_DELAY=PT30S

# Redis database used only by the automated integration tests (DB 15).
# The application and Docker Compose keep using DB 0.
TEST_REDIS_DATABASE=15
